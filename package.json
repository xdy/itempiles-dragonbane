{
  "name": "itempiles-dragonbane",
  "type": "module",
  "description": "This module adds support for the Dragonbane / Drakar och Demoner system within the Item Piles module",
  "packageManager": "pnpm@10.32.1",
  "main": "dist/itempiles-dragonbane.js",
  "module": "dist/itempiles-dragonbane.js",
  "exports": {
    ".": {
      "import": "./dist/itempiles-dragonbane.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch --mode development",
    "clean": "rimraf dist .cache",
    "clean:link": "node ./tools/link-project.js --clean",
    "format": "prettier -w .",
    "link-project": "node ./tools/link-project.js",
    "link": "node ./tools/link-project.js",
    "lint": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.3",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "esbuild": "^0.27.4",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-tsdoc": "^0.5.2",
    "rimraf": "^6.0.1",
    "semantic-release": "^25.0.3",
    "vite": "^8.0.0",
    "vite-plugin-checker": "^0.12.0",
    "vite-plugin-static-copy": "^3.1.1",
    "yargs": "^18.0.0",
    "yoctocolors": "^2.1.2"
  },
  "browserslist": [
    ">5%",
    "not IE 11"
  ]
}
